{>"layout_m_home"/}

{<header}
	<div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="m-0">
                    {#__ key="module.m_home"/}&nbsp;
                    <small>
                        {#__ key="module.module"/}
                    </small>
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                	<li class="breadcrumb-item">
                        <a href="/module/home">
                            <i class="fa fa-home"></i>&nbsp;&nbsp;
                            {#__ key="module.home"/}
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        {#__ key="settings.legend"/}
                    </li>
                </ol>
            </div>
        </div>
    </div>
{/header}

{<content}
	<div class="container-fluid">
		<div class="row">
			<div class="col-12">
				<div class="card">
					<div class="card-header">
						<h3 class="card-title">
							{#__ key="settings.legend"/}
						</h3>
						<div class="card-tools">
							<button type="button" class="btn btn-tool" data-card-widget="collapse" title="collapse">
							<i class="fas fa-minus"></i>
							</button>
						</div>
					</div>
					<div class="card-body">
						<div class="form-group">
						<label>{#__ key="settings.lang"/}</label><br/>
						<a data-lang="fr-FR" class='chooseLanguage btn {@eq key=lang_user value="fr-FR"}btn-primary{:else}btn-default{/eq}'>
							Français
						</a>
						&nbsp;&nbsp;
						<a data-lang="en-EN" class='chooseLanguage btn {@eq key=lang_user value="en-EN"}btn-primary{:else}btn-default{/eq}'>
							English
						</a>
						<br><br>
						<form action="/user/settings" method="post">
							{#e_user}
								<div id="fields" class="row">
									<div data-field="f_login" class="col-xs-12 col-sm-6">
										<div class="form-group">
											<label for="f_login">
												{#__ key="entity.e_user.f_login"/}&nbsp;
												{@inline_help field="f_login"}
												<i data-entity="e_user" data-field="f_login" class="inline-help fa fa-info-circle" style="color: #1085EE"></i>
												{/inline_help}
											</label>
											<input class="form-control" placeholder='{#__ key="entity.e_user.f_login" /}' name="f_login" value="{f_login}" type="text" maxlength="255" disabled="" readonly="">
										</div>
									</div>
									<div data-field="f_email" class="col-xs-12 col-sm-6">
										<div class="form-group">
											<label for="f_email">
												{#__ key="entity.e_user.f_email"/}&nbsp;
												{@inline_help field="f_email"}
												<i data-entity="e_user" data-field="f_email" class="inline-help fa fa-info-circle" style="color: #1085EE"></i>
												{/inline_help}
											</label>
											<div class="input-group">
												<div class="input-group-prepend">
													<span class='input-group-text'>
														<i class="fa fa-envelope"></i>
													</span>
												</div>
												<input class="form-control" placeholder='{#__ key="entity.e_user.f_email" /}' name="f_email" value="{f_email}" type="text" data-type="email">
											</div>
										</div>
									</div>
									<div data-field="f_role" class="col-xs-12 col-sm-6">
										<div class="form-group">
											<label for="f_role">
												{#__ key="entity.e_user.r_role" /}
												{@inline_help field="r_role"}
												<i data-entity="e_user" data-field="r_role" class="inline-help fa fa-info-circle" style="color: #1085EE"></i>
												{/inline_help}
											</label>
											<select multiple="" disabled="" readonly="" class="form-control" name="r_role" data-source="role" data-using="f_label" style="width: 100%;">
												{#r_role}
												<option value="{f_label}" selected="">
													{f_label}
												</option>
												{/r_role}
											</select>
										</div>
									</div>
									<div data-field="f_group" class="col-xs-12 col-sm-6">
										<div class="form-group">
											<label for="f_group">
												{#__ key="entity.e_user.r_group" /}
												{@inline_help field="r_group"}
												<i data-entity="e_user" data-field="r_group" class="inline-help fa fa-info-circle" style="color: #1085EE"></i>
												{/inline_help}
											</label>
											<select multiple="" disabled="" readonly="" class="form-control" name="r_group" data-source="group" data-using="f_label" style="width: 100%;">
												{#r_group}
												<option value="{f_label}" selected="">
													{f_label}
												</option>
												{/r_group}
											</select>
										</div>
									</div>
								</div>
							{/e_user}
							<br>
							<div class="btn-group">
								<a class="btn btn-default" href="javascript:history.back();">
									<i class="fa fa-arrow-left"></i>&nbsp;&nbsp;{#__ key="button.return"/}
								</a>&nbsp;
							</div>
							<button type="submit" class="btn btn-primary">
								<i class="fas fa-save">&nbsp;&nbsp;</i>
								{#__ key="button.save"/}
							</button>&nbsp;
							{@ifTrue key=isLocal}
							<button type="button" id='send_reset_password' class="btn btn-info">
								<i class="fa fa-envelope fa-md">&nbsp;&nbsp;</i>
								<span>
									{#__ key="administration.user.send_email_reset_password"/}
								</span>
							</button>&nbsp;
							{/ifTrue}
						</form>
					</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{/content}

{<custom_js}
	<script>
		const RESEND_MAIL_SUCCESS = '{#__ key="administration.user.resend_email_success" /}';

		$(document).ready(function() {

			/* Apply focus on first row's form element */
			firstElementFocus();

			NodeaForms();

			$(document).on("click", ".chooseLanguage", function() {
				var lang = $(this).attr("data-lang");
				var ajaxdata = {
					lang: lang
				};
				$.ajax({
					url: '/app/change_language',
					type: 'POST',
					data: JSON.stringify(ajaxdata),
					dataType: 'json',
					contentType: "application/json",
					context: this,
					success: function(data) {
						if (data.success) {
							location.reload();
							NodeaForms();
						}
					},
					error: function(error) {
						console.error(error);
					}
				});
			});

			$(document).on('click', '#send_reset_password', function() {
                $(this).replaceWith('<button disabled class="btn btn-info"><i class="fas fa-check"></i></button>');
                $.ajax({
                    url: '/user/send_reset_password',
                    method: 'POST',
                    data: {
                        login: $('input[name="f_login"]').val(),
                        email: $('input[name="f_email"]').val(),
                    },
                    success: function() {
                        toastr.success(RESEND_MAIL_SUCCESS);
                    },
                    error: function(err) {
                        console.error(err);
                        toastr.error(err);
                    }
                })
            });
		});
	</script>
{/custom_js}