{>"login_layout"/}
{<custom_css}
	<style>
		.toast-top-center{
			top: 20px;
		}
	</style>
{/custom_css}
{<content}
	<p class="login-box-msg">
		<b>{#__ key="app.name"/}</b><br>
		{#__ key="login.first_connection.title"/}
	</p>

	<div id="error-box"></div>

	<form id="first_connection" action="/first_connection" method="post">
		<input type="hidden" name="token" value="{token}">
		<label id="label_login" for="login">{#__ key="login.login"/}</label>
		<div class="input-group mb-3">
			<input aria-labelledby="label_login" type="text" class="form-control" placeholder='{#__ key="login.login"/}' name="login" value="{login}" required>
			<div class="input-group-append">
				<div class="input-group-text">
					<span class="fas fa-user"></span>
				</div>
			</div>
		</div>
		<label id="label_password" for="password">{#__ key="login.password"/} &nbsp;<i class="inline-help fa fa-info-circle login-help" data-title='{#__ key="login.password"/}' data-content='{#__ key="login.help.password_content"/}'></i></label>
		<div class="input-icon-right mb-3">
			{@eq key=config.env value="develop"}
				<input aria-labelledby="label_password" type="password" id="password" class="form-control" placeholder='{#__ key="login.password"/}' name="password" required>
			{:else}
				<input aria-labelledby="label_password" type="password" id="password" class="form-control" placeholder='{#__ key="login.password"/}' name="password" title="12 caractères minimum avec une majuscule, un chiffre et un caractère spécial !@#$%^&?*" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&?*]).{12,120}$" required>
			{/eq}
			<button type="button" class="password-toggle">
				<i class="fa fa-eye" aria-hidden="true"></i>
			</button>
		</div>
		<label id="label_confirm_password" for="confirm_password">{#__ key="login.confirm_password"/}</label>
		<div class="input-icon-right mb-3">
			{@eq key=config.env value="develop"}
				<input aria-labelledby="label_confirm_password" type="password" id="confirm_password" class="form-control" placeholder='{#__ key="login.confirm_password"/}' name="confirm_password" required>
			{:else}
				<input aria-labelledby="label_confirm_password" type="password" id="confirm_password" class="form-control" placeholder='{#__ key="login.confirm_password"/}' name="confirm_password" title="12 caractères minimum avec une majuscule, un chiffre et un caractère spécial !@#$%^&?*" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&?*]).{12,120}$" required>
			{/eq}
			<button type="button" class="password-toggle">
				<i class="fa fa-eye" aria-hidden="true"></i>
			</button>
		</div>
		<br>
		<div class="row">
			<div class="col-12">
				<button type="submit" class="btn btn-primary btn-block">{#__ key="login.submit"/}</button>
				<a class="btn btn-default btn-block" href='/'>{#__ key="button.cancel"/}</a>
			</div>
		</div>
	</form>
{/content}

{<custom_js}
	<script type="text/javascript">
		const env = "{config.env}";
		const errorMessagePassword = '{#__ key="login.first_connection.passwordNotValid"/}';
	</script>
	<script src="/core/js/login.js" type="text/javascript"></script>
	<script src="/core/js/first_connection.js" type="text/javascript"></script>
{/custom_js}